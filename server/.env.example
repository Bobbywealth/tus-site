# Stripe (use sk_test_... for dev, sk_live_... for prod)
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=***

# Stripe webhook signing secret — REQUIRED for order notifications to work.
# Register the endpoint at https://dashboard.stripe.com/webhooks
# Point it at: https://tus-api.onrender.com/webhook
# Subscribe to event: checkout.session.completed
# Then copy the "Signing secret" (whsec_...) here.
STRIPE_WEBHOOK_SECRET=

# Comma-separated origins allowed to call this API (no trailing slash)
ALLOWED_ORIGINS=https://theuntoldseason.com,http://localhost:5173

# Public URL the success/cancel redirect points to (no trailing slash)
PUBLIC_URL=https://theuntoldseason.com

PORT=3001

# ── Order notification emails (nodemailer SMTP) ─────────────────────────────
# SMTP_URL is the connection string. Examples:
#   Gmail (App Password):    smtps://you@gmail.com:abcd-efgh-ijkl-mnop@smtp.gmail.com:465
#   SendGrid:                sm://apikey:SG.xxx@smtp.sendgrid.net:587
#   Resend:                  smtp://resend:re_xxx@smtp.resend.com:587
#   Postmark:                smtps://postmark:token@smtp.postmarkapp.com:465
# Gmail setup: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords (free, instant).
SMTP_URL=

# From-address shown in the email "From:" header
# Use a real address you control (or one your SMTP provider lets you send from)
MAIL_FROM=The Untold Season <noreply@theuntoldseason.com>

# Bobby's email — where merchant order alerts go
NOTIFY_EMAIL=

# Send order confirmation to the customer (set to "false" to disable)
CUSTOMER_CONFIRMATION=true
